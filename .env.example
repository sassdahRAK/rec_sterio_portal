# Base URL of the recsterio backend API (include /api/v1).
# Leave unset for the normal setup: the dev server proxies /api to the backend,
# and a deployed portal is served from the same origin as the API.
# Set an absolute URL only when the portal and API live on different hosts
# (then also add the portal origin to CORS_ORIGINS on the backend).
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# OneDrive/Entra app registration for the "Connect to Drive" consent screen.
# The server supplies the client id via /cloud/providers, so this variable is
# an override only — set it for a deployment whose portal is built separately
# from the API. Leave it unset to take the server's id.
# VITE_ONEDRIVE_CLIENT_ID=
# VITE_ONEDRIVE_TENANT=common   # defaults to "common" when unset
